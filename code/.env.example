# ============================================================
# REQUIRED
# ============================================================

# Gemini API key – get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/llm_knowledge_base

# ============================================================
# OPTIONAL
# ============================================================

# Internal Bearer token for API authentication.
# If set, all endpoints require an Authorization: Bearer <token> header.
# If not set, authentication is disabled.
INTERNAL_API_TOKEN=

# Number of recent messages to keep in context per user
CHAT_WINDOW_SIZE=20

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# MCP HTTP timeouts (seconds)
MCP_HTTP_TIMEOUT=60.0
MCP_HTTP_READ_TIMEOUT=300.0

# Server bind settings
HOST=0.0.0.0
PORT=8005
WORKERS=2
UVICORN_RELOAD=0   # set to 1 for development hotreload

# ============================================================
# MCP SERVER TOKENS (if required in mcp.json)
# ============================================================

# Example: Token for markdown-vault-mcp
MARKDOWN_VAULT_MCP_BEARER_TOKEN=your_secure_token_here