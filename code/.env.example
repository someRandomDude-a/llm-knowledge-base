# =====================================================================
# llm-knowledge-base — example environment configuration
# =====================================================================
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit your real secrets.
#
# Anything referenced as ${VAR} inside code/mcp.json is also resolved
# from the environment, so you can keep MCP server tokens in here too.
# =====================================================================


# ---------------------------------------------------------------------
# REQUIRED — Gemini API key
# ---------------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey
# Without this, the process refuses to start.
GEMINI_API_KEY=your-gemini-api-key-here


# ---------------------------------------------------------------------
# REQUIRED (HTTP API mode only) — PostgreSQL connection string
# ---------------------------------------------------------------------
# Standard libpq DSN. The schema (user_chat_history) is created
# automatically on first use.
#
# Two aliases are also accepted: POSTGRES_CONNECTION_STRING,
# POSTGRES_URL. DATABASE_URL wins if multiple are set.
#
# Local Docker example (matches the docker-compose.yml in the README):
#   DATABASE_URL=postgresql://llm:llm@localhost:5432/llm
#
# Production example:
#   DATABASE_URL=postgresql://user:strong-password@db.internal:5432/llm?sslmode=require
DATABASE_URL=postgresql://llm:llm@localhost:5432/llm


# ---------------------------------------------------------------------
# OPTIONAL — Conversation context window
# ---------------------------------------------------------------------
# Number of past messages re-injected as context for each user on every
# turn. Pure read — old rows are never deleted. Larger = more context
# but more tokens per request. 20 is a sensible default.
CHAT_WINDOW_SIZE=20


# ---------------------------------------------------------------------
# OPTIONAL — Server bind address / port
# ---------------------------------------------------------------------
# Defaults shown. Match the EXPOSE in docker/Dockerfile (8005) when
# running in a container.
HOST=0.0.0.0
PORT=8005


# ---------------------------------------------------------------------
# OPTIONAL — uvicorn worker processes
# ---------------------------------------------------------------------
# Number of uvicorn worker processes. Each one runs its own
# AgentManager with its own MCP connections. Bump this for higher
# throughput; keep an eye on DB connection count (max_conn * workers).
# Ignored when UVICORN_RELOAD=1.
WORKERS=2


# ---------------------------------------------------------------------
# OPTIONAL — Auto-reload for local development
# ---------------------------------------------------------------------
# Set to 1 to enable uvicorn's file watcher (auto-restart on .py
# changes). Mutually exclusive with WORKERS. DO NOT use in production.
UVICORN_RELOAD=0


# ---------------------------------------------------------------------
# OPTIONAL — Logging
# ---------------------------------------------------------------------
# Standard Python logging level. Applied to both the app and uvicorn.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# =====================================================================
# MCP server secrets (referenced from code/mcp.json as ${VAR})
# =====================================================================
# Anything you put here can be referenced inside code/mcp.json. Examples:
#
#   {
#     "mcpServers": {
#       "github": {
#         "command": "npx",
#         "args": ["-y", "@modelcontextprotocol/server-github"],
#         "env": {
#           "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
#         }
#       }
#     }
#   }
#
# Uncomment and fill in the ones you need.
# ---------------------------------------------------------------------

# GITHUB_TOKEN=ghp_...
# GITLAB_TOKEN=glpat-...
# NOTION_API_KEY=secret_...
# SLACK_BOT_TOKEN=xoxb-...
# REMOTE_MCP_TOKEN=...
